# PostgreSQL (managed, e.g. Cloud SQL). Use sslmode=require when exposed on a public IP.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dms?sslmode=require

# S3 Configuration
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=mykey
S3_SECRET_KEY=mysecret
GCP_BUCKET_NAME=my-bucket

# Email Encryption
EMAIL_ENCRYPTION_KEY=mykey

# AI Model Configuration
MODEL_NAME=gemini-2.5-pro
BASE_URL=https://mycustomdomain1479.com
CUSTOM_API_KEY=mykey

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# MCP Server Configuration
MCP_SERVER_URL=http://mcp_server:8001/sse


# OpenSearch
OPENSEARCH_URL=http://opensearch:9200

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
